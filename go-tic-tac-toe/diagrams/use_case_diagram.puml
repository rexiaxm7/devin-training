@startuml Use Case Diagram

left to right direction
actor "Player ○" as Player1
actor "Player ×" as Player2

rectangle "Tic-Tac-Toe Game" {
  usecase "View Game Board" as UC1
  usecase "Place Mark on Board" as UC2
  usecase "Check Win Condition" as UC3
  usecase "Check Draw Condition" as UC4
  usecase "Switch Player Turn" as UC5
  usecase "Replay Game" as UC6
  usecase "End Game" as UC7
  usecase "View Board Position Numbers" as UC8
}

Player1 --> UC1
Player1 --> UC2
Player1 --> UC6
Player1 --> UC7
Player1 --> UC8

Player2 --> UC1
Player2 --> UC2
Player2 --> UC6
Player2 --> UC7
Player2 --> UC8

UC2 ..> UC3 : <<include>>
UC2 ..> UC4 : <<include>>
UC2 ..> UC5 : <<include>>
UC6 ..> UC1 : <<include>>

@enduml
